# 部署时的本地数据与密钥
deploy/.env
# .env 的备份副本同样含密钥。只写 `deploy/.env` 是不够的：
# ops.sh / 手工 cp 产生的 .env.bak.* 不会被上一条匹配，`git add -A` 就会把密钥提交上去。
deploy/.env.*
deploy/.env.bak*
deploy/certs/
deploy/data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地临时文件
*.log
tmp/
.tmp/

# 冒烟测试与本地数据库
*.db
*.db-wal
*.db-shm
.smoke*
