# 用法：cp .env.example .env，然后逐项改成自己的值。
# 这个文件同时被 docker compose 读取（用于 ${...} 插值）和注入 gateway 容器。

# ===== 对外服务 =====
PUBLIC_BASE_URL=https://agent.example.com
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# true：不调用真实 agent，直接返回样例摘要，供 App 开发方联调
MOCK_MODE=true

# ===== 安全 =====
JWT_SECRET=please-change-me-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_DAYS=30

# App 侧可信直传（模式 B）：App 后端用它与网关换 Token。留空则关闭该模式。
EXCHANGE_HMAC_SECRET=
# 模式 B 允许的签名时间戳偏差（秒），超出即拒绝，防重放
EXCHANGE_TIMESTAMP_TOLERANCE_SECONDS=300

# 任务完成回调签名密钥
CALLBACK_HMAC_SECRET=please-change-me
# 允许回调的域名白名单，逗号分隔（防 SSRF）
CALLBACK_ALLOWED_HOSTS=app.example.com
# 回调单次超时、最大尝试次数与重试间隔（秒）
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_RETRY_DELAYS=[5,30,120]

# 管理接口令牌（X-Admin-Token）。留空则 /internal/* 全部关闭。
# 生成方式：openssl rand -hex 24
ADMIN_TOKEN=please-change-me-admin

# ===== opencode 实例密码 =====
# 每个实例一把独立密码，gateway 通过 OPENCODE_INSTANCES 读取同一份值。
# 生成方式：openssl rand -hex 24
OC1_PASSWORD=please-change-me-1
OC2_PASSWORD=please-change-me-2
OC3_PASSWORD=please-change-me-3

# ===== 配额与队列 =====
DEFAULT_DAILY_QUOTA=30
MAX_IN_FLIGHT_PER_USER=1
MAX_QUEUE_DEPTH_PER_USER=3
TASK_TIMEOUT_SECONDS=180
MAX_TEXT_CHARS=200000
MAX_FETCH_CHARS=20000
MAX_OUTPUT_CHARS=4000
RESULT_RETENTION_DAYS=30
# 每日配额的「今天」按哪个时区切分（默认东八区）
QUOTA_TIMEZONE_OFFSET_HOURS=8
# SSE 心跳间隔（注释帧），用于穿透代理的 idle 超时
SSE_PING_INTERVAL_SECONDS=15

# ===== 对外暴露 =====
# App 若用 H5/WebView 发起跨域请求，在此填白名单来源，逗号分隔；原生请求留空即可
CORS_ALLOW_ORIGINS=

# ===== 实例池 =====
POOL_HEALTH_INTERVAL_SECONDS=10
POOL_HEALTH_FAILURE_THRESHOLD=3
INSTANCE_IDLE_DISPOSE_MINUTES=20
DISPATCHER_INTERVAL_SECONDS=0.5
OPENCODE_REQUEST_TIMEOUT_SECONDS=30
# MOCK 模式下每个事件之间的间隔（秒），调小可加快联调
MOCK_STEP_DELAY_SECONDS=0.6

# ===== 出境抓取（不需要时留空）=====
FETCH_HTTP_PROXY=
FETCH_HTTPS_PROXY=

# ===== 模型 =====
# 模型由 gateway 在下发任务时指定；provider 凭据在实例启动时写入。
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
# 下发给 agent 的名字，对应 opencode/config/agents/summarizer.md
SUMMARIZER_AGENT=summarizer

# ===== 存储 =====
DATABASE_URL=sqlite:////srv/agent/data/gateway.db
LOG_LEVEL=INFO
