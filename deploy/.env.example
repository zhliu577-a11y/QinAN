# 用法：cp .env.example .env，然后逐项改成自己的值。
# 这个文件同时被 docker compose 读取（用于 ${...} 插值）和注入 gateway 容器。

# ===== 对外服务 =====
PUBLIC_BASE_URL=https://agent.example.com
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
# true：不调用真实 agent，直接返回样例摘要，供 App 开发方联调
# 「假 agent」总开关：true 时网关根本不启动 opencode 客户端，
# 直接返回固定样例文本。它和下面的模拟模型是**两个不同层次**的模拟：
#   MOCK_MODE=true          → 不经过 opencode，最快，用于 App 侧对接口/SSE/配额
#   MOCK_MODE=false + 模拟模型 → 真的走 opencode → mock-model，用于验证整条链路
# 默认 false，配合下面的 MODEL_BASE_URL 跑完整链路。
MOCK_MODE=false

# ===== 安全 =====
JWT_SECRET=please-change-me-at-least-32-bytes
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_DAYS=30

# App 侧可信直传（模式 B）：App 后端用它与网关换 Token。留空则关闭该模式。
# 与 App 团队约定同一个值；生成：openssl rand -hex 32
# 注意：这个密钥只放服务端之间，绝不要下发到 App 客户端。
EXCHANGE_HMAC_SECRET=
# 模式 B 允许的签名时间戳偏差（秒），超出即拒绝，防重放
EXCHANGE_TIMESTAMP_TOLERANCE_SECONDS=300

# 任务完成回调签名密钥
CALLBACK_HMAC_SECRET=please-change-me
# 允许回调的域名白名单，逗号分隔（防 SSRF）
CALLBACK_ALLOWED_HOSTS=app.example.com
# 回调单次超时、最大尝试次数与重试间隔（秒）
CALLBACK_TIMEOUT_SECONDS=5
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_RETRY_DELAYS=[5,30,120]

# 管理接口令牌（X-Admin-Token）。留空则 /internal/* 全部关闭。
# 生成方式：openssl rand -hex 24
ADMIN_TOKEN=please-change-me-admin

# ===== opencode 实例密码 =====
# 每个实例一把独立密码，gateway 通过 OPENCODE_INSTANCES 读取同一份值。
# 生成方式：openssl rand -hex 24
OC1_PASSWORD=please-change-me-1
OC2_PASSWORD=please-change-me-2
OC3_PASSWORD=please-change-me-3

# ===== 配额与队列 =====
DEFAULT_DAILY_QUOTA=30
MAX_IN_FLIGHT_PER_USER=1
MAX_QUEUE_DEPTH_PER_USER=3
TASK_TIMEOUT_SECONDS=180
MAX_TEXT_CHARS=200000
MAX_FETCH_CHARS=20000
MAX_OUTPUT_CHARS=4000
RESULT_RETENTION_DAYS=30
# 每日配额的「今天」按哪个时区切分（默认东八区）
QUOTA_TIMEZONE_OFFSET_HOURS=8
# SSE 心跳间隔（注释帧），用于穿透代理的 idle 超时
SSE_PING_INTERVAL_SECONDS=15

# ===== 对外暴露 =====
# App 若用 H5/WebView 发起跨域请求，在此填白名单来源，逗号分隔；原生请求留空即可
CORS_ALLOW_ORIGINS=

# ===== 实例池 =====
POOL_HEALTH_INTERVAL_SECONDS=10
POOL_HEALTH_FAILURE_THRESHOLD=3
INSTANCE_IDLE_DISPOSE_MINUTES=20
DISPATCHER_INTERVAL_SECONDS=0.5
OPENCODE_REQUEST_TIMEOUT_SECONDS=30
# MOCK 模式下每个事件之间的间隔（秒），调小可加快联调
MOCK_STEP_DELAY_SECONDS=0.6

# ===== 出境抓取（不需要时留空）=====
# 这两个是给 opencode 实例用的**全局**出网代理，不是「只作用于抓取」：
# 一旦填上，模型调用也会走它。所以模型地址必须同时出现在 NO_PROXY 里
# （docker-compose.yml 的 NO_PROXY 列表），否则所有任务会失败，报
# AI_APICallError: Cannot connect to API。实测：代理指向坏地址、模型域名不在
# NO_PROXY 时，模型端收到 0 个请求，任务 66 秒后 failed。
FETCH_HTTP_PROXY=
FETCH_HTTPS_PROXY=

# ===== 模型 =====
# gateway 下发任务时只指定「provider id + model id」，真正的服务地址与密钥在实例启动时
# 注入（baseURL 由 opencode/config/opencode.json 从 MODEL_BASE_URL 读取并覆写 provider）。
#
# provider / model 的取值必须真实存在，写错不会在启动时报错，而是第一次调用才失败。
# 可用值查询：https://models.dev/api.json，或进入容器执行 opencode models
# 但那份清单只是「opencode 认得的名字」，不代表你的账号/网关真能调 —— 最终以
#   curl -s -H "Authorization: Bearer $MODEL_API_KEY" "$MODEL_BASE_URL/models"
# 的返回为准。
#
# 默认走模拟模型（deploy/mock-model/），不依赖任何外部服务。
#   docker compose up -d 会连它一起拉起，无需额外参数。
#   MODEL_BASE_URL=http://mock-model:8000/v1，MODEL_API_KEY 随便填。
#   它只在 compose 内部网络里，不映射端口，不能用也无法用于生产。
#
# 下面两行已经是 DeepSeek 官方 flash 档的取值，接真实模型时只需把地址与 key 换成真的：
#   MODEL_BASE_URL=https://api.deepseek.com/v1
#   MODEL_API_KEY=sk-官方签发的key
# 地址必须兼容 OpenAI：GET /v1/models 列模型、POST /v1/chat/completions 对话。
#
# DeepSeek 官方可用的 flash 有两个，规格与单价完全一致（输入 $0.15 / 输出 $0.60 每百万 token，
# 上下文 1M），按代次取新的即可：
#   deepseek-flash      DeepSeek V4.1 Flash   ← 当前默认
#   deepseek-v4-flash   DeepSeek V4 Flash
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=http://mock-model:8000/v1
MODEL_API_KEY=mock-key-not-used
# 下发给 agent 的名字，对应 opencode/config/agents/summarizer.md
SUMMARIZER_AGENT=summarizer

# ===== 存储 =====
DATABASE_URL=sqlite:////srv/agent/data/gateway.db
LOG_LEVEL=INFO
