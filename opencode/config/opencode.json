{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "{env:MODEL_BASE_URL}",
        "apiKey": "{env:MODEL_API_KEY}"
      }
    }
  },
  "permission": {
    "*": "deny",
    "webfetch": "allow",
    "bash": "deny",
    "edit": "deny",
    "apply_patch": "deny",
    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "lsp": "deny",
    "skill": "deny",
    "todowrite": "deny",
    "websearch": "deny",
    "question": "deny"
  }
}
